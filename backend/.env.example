# MongoDB connection (optional – defaults are in db.js)
# Use this if you want to override or avoid hardcoded credentials.

# SRV format (default). If you get "querySrv ECONNREFUSED", see below.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/DBNAME?retryWrites=true&w=majority

# If SRV lookup fails (e.g. DNS/network blocks SRV), get the "Standard connection string"
# from Atlas: Connect → Drivers → connection string → turn OFF "Use SRV". Then set:
# MONGODB_URI_STANDARD=mongodb://USER:PASS@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/DBNAME?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
